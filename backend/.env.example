# Copy to .env and adjust as needed.

# Ollama server used for label extraction. Points at localhost for Mac
# prototyping; re-point at the Linux/AMD GPU box's address once that's up.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
# Keep in step with OLLAMA_NUM_PARALLEL on the Ollama server.
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_WARMUP_ON_STARTUP=true

# Long edge (px) label photos are downscaled to before extraction.
MAX_IMAGE_EDGE_PX=1024

DATABASE_URL=sqlite:///./ttb_review.db

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000
