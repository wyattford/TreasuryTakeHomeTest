# Copy to .env and adjust as needed.

# Which service runs the vision model: "ollama" (self-hosted) or "bedrock".
INFERENCE_PROVIDER=ollama

# Ollama server used for label extraction. Points at localhost for Mac
# prototyping; re-point at the Linux/AMD GPU box's address once that's up.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
# Keep in step with OLLAMA_NUM_PARALLEL on the Ollama server.
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_WARMUP_ON_STARTUP=true

# Amazon Bedrock (INFERENCE_PROVIDER=bedrock). BEDROCK_KEY is a Bedrock API
# key from the Bedrock console's "API keys" page.
BEDROCK_KEY=
BEDROCK_REGION=us-west-2
BEDROCK_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0
BEDROCK_MAX_CONCURRENCY=4

# Long edge (px) label photos are downscaled to before extraction.
MAX_IMAGE_EDGE_PX=1024

DATABASE_URL=sqlite:///./ttb_review.db

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:3000
